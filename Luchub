local function createButton(posY, text)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 220, 0, 36)
    btn.Position = UDim2.new(0, 10, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(80, 40, 140)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamBold
    btn.Parent = MainFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    return btn
end

-- 1. Nút Fix Lag
local BtnFixLag = createButton(45, "🚀 BẬT FIX LAG / TẮT HIỆU ỨNG")
BtnFixLag.MouseButton1Click:Connect(function()
    pcall(function()
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Material = Enum.Material.SmoothPlastic
                v.Reflectance = 0
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") then
                v:Destroy()
            end
        end
    end)
    BtnFixLag.Text = "✅ ĐÃ BẬT FIX LAG"
end)

-- 2. Nút Fast Attack (Tự động đánh không cần click màn hình)
local BtnFast = createButton(85, "⚔️ BẬT FAST ATTACK (AUTO)")
local fastAttackEnabled = false
BtnFast.MouseButton1Click:Connect(function()
    fastAttackEnabled = not fastAttackEnabled
    if fastAttackEnabled then
        BtnFast.Text = "✅ ĐANG BẬT FAST ATTACK"
        task.spawn(function()
            while fastAttackEnabled do
                pcall(function()
                    -- Kích hoạt đòn đánh liên tục thông qua Combat Framework hoặc RemoteEvent chuẩn Blox Fruits
                    local combat = debug.getupvalues(require(LocalPlayer.PlayerScripts.CombatFramework))
                    local cam = combat[2]
                    for _, v in pairs(cam.activeController.aliases) do
                        if v then
                            v.tapToAttack = true
                        end
                    end
                end)
                task.wait(0.01)
            end
        end)
    else
        BtnFast.Text = "⚔️ BẬT FAST ATTACK (AUTO)"
    end
end)

-- 3. Nút Hitbox Siêu Xa (An toàn không mất nút trang bị)
local BtnHitbox = createButton(125, "🎯 BẬT ĐÁNH XA (HITBOX)")
local hitboxEnabled = false
BtnHitbox.MouseButton1Click:Connect(function()
    hitboxEnabled = not hitboxEnabled
    if hitboxEnabled then
        BtnHitbox.Text = "✅ ĐANG BẬT HITBOX XA"
        task.spawn(function()
            while hitboxEnabled do
                pcall(function()
                    for _, v in pairs(Workspace.Enemies:GetChildren()) do
                        local hrp = v:FindFirstChild("HumanoidRootPart")
                        local hum = v:FindFirstChild("Humanoid")
                        if hrp and hum and hum.Health > 0 then
                            hrp.Size = Vector3.new(30, 30, 30)
                            hrp.Transparency = 0.8
                            hrp.CanCollide = false
                        end
                    end
                end)
                task.wait(1)
            end
        end)
    else
        BtnHitbox.Text = "🎯 BẬT ĐÁNH XA (HITBOX)"
    end
end)

-- 4. ESP Player (Kèm hiện Tên và Máu HP)
local BtnEspPlayer = createButton(165, "👁️ BẬT ESP PLAYER + MÁU")
local espPlayerEnabled = false
BtnEspPlayer.MouseButton1Click:Connect(function()
    espPlayerEnabled = not espPlayerEnabled
    if espPlayerEnabled then
        BtnEspPlayer.Text = "✅ ĐANG BẬT ESP PLAYER"
        task.spawn(function()
            while espPlayerEnabled do
                pcall(function()
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") then
                            local head = p.Character.Head
                            local hum = p.Character.Humanoid
                            if not head:FindFirstChild("LuchubPlayerESP") then
                                local bg = Instance.new("BillboardGui", head)
                                bg.Name = "LuchubPlayerESP"
                                bg.Size = UDim2.new(0, 120, 0, 50)
                                bg.AlwaysOnTop = true
                                local txt = Instance.new("TextLabel", bg)
                                txt.Size = UDim2.new(1, 0, 1, 0)
                                txt.BackgroundTransparency = 1
                                txt.TextColor3 = Color3.fromRGB(0, 255, 255)
                                txt.TextSize = 12
                                txt.Font = Enum.Font.GothamBold
                                txt.Parent = bg
                            end
                            local espGui = head:FindFirstChild("LuchubPlayerESP")
                            if espGui then
                                local txtLabel = espGui:FindFirstChildOfClass("TextLabel")
                                if txtLabel then
                                    txtLabel.Text = p.Name .. "\n❤️ HP: " .. math.floor(hum.Health)
                                end
                            end
                        end
                    end
                end)
                task.wait(1)
            end
        end)
    else
        BtnEspPlayer.Text = "👁️ BẬT ESP PLAYER + MÁU"
        pcall(function()
            for _, p in pairs(Players:GetPlayers()) do
                if p.Character and p.Character:FindFirstChild("Head") then
                    local esp = p.Character.Head:FindFirstChild("LuchubPlayerESP")
                    if esp then esp:Destroy() end
                end
            end
        end)
    end
end)

-- 5. ESP Trái Ác Quỷ Update 30 & Auto Bay Nhặt Trái
local BtnEspFruit = createButton(205, "🍎 ESP TRÁI + AUTO NHẶT")
local espFruitEnabled = false
BtnEspFruit.MouseButton1Click:Connect(function()
    espFruitEnabled = not espFruitEnabled
    if espFruitEnabled then
        BtnEspFruit.Text = "✅ ĐANG CHẠY ESP TRÁI & NHẶT"
        task.spawn(function()
            while espFruitEnabled do
                pcall(function()
                    -- Quét toàn bộ kho lưu trữ trái ác quỷ Update 30
                    for _, obj in pairs(Workspace:GetChildren()) do
                        if obj:IsA("Tool") and (obj.Name:find("Fruit") or obj.Name:find("Devil") or obj:Name:find("Trái")) then
                            if obj:FindFirstChild("Handle") then
                                if not obj.Handle:FindFirstChild("FruitESPUp30") then
                                    local bg = Instance.new("BillboardGui", obj.Handle)
                                    bg.Name = "FruitESPUp30"
                                    bg.Size = UDim2.new(0, 150, 0, 50)
                                    bg.AlwaysOnTop = true
                                    bg.StudsOffset = Vector3.new(0, 2, 0)
                                    local txt = Instance.new("TextLabel", bg)
                                    txt.Size = UDim2.new(1, 0, 1, 0)
                                    txt.BackgroundTransparency = 1
                                    txt.TextColor3 = Color3.fromRGB(255, 50, 50)
                                    txt.TextSize = 13
                                    txt.Font = Enum.Font.GothamBold
                                    txt.Parent = bg
                                end
                                
                                -- Đo khoảng cách và tự động bay đến nhặt
                                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                if hrp then
                                    local distance = math.floor((hrp.Position - obj.Handle.Position).Magnitude)
                                    local espGui = obj.Handle:FindFirstChild("FruitESPUp30")
                                    if espGui then
                                        local txtLabel = espGui:FindFirstChildOfClass("TextLabel")
                                        if txtLabel then
                                            txtLabel.Text = "🍎 " .. obj.Name .. "\n[" .. distance .. "m] (Đang bay nhặt!)"
                                        end
                                    end
                                    
                                    -- Tự động dịch chuyển/bay đến vị trí trái ác quỷ để nhặt
                                    hrp.CFrame = CFrame.new(obj.Handle.Position + Vector3.new(0, 3, 0))
                                end
                            end
                        end
                    end
                end)
                task.wait(0.5)
            end
        end)
    else
        BtnEspFruit.Text = "🍎 ESP TRÁI + AUTO NHẶT"
    end
end)

