-- ==========================================
-- LỰC HUB PRO - FULL OPTIMIZED EDITION (120HZ)
-- ==========================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

-- Chống trùng lặp GUI cũ
pcall(function()
    local coreGui = LocalPlayer:FindFirstChild("PlayerGui")
    if coreGui and coreGui:FindFirstChild("LuchubProUltimate") then
        coreGui.LuchubProUltimate:Destroy()
    end
end)

-- Mở khóa FPS tối đa cho màn hình 120Hz
pcall(function()
    setfpscap(999)
end)

-- Tối ưu hóa đồ họa cực đoan (Cắt giảm hiệu ứng nặng máy)
pcall(function()
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level0
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    for _, v in pairs(Lighting:GetDescendants()) do
        if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Clouds") or v:IsA("Sky") then
            v.Enabled = false
        end
    end
    -- Xóa hiệu ứng rác trong map
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Smoke") then
            v:Destroy()
        end
    end
end)

-- Giao diện Lực Hub Pro
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "LuchubProUltimate"
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 240, 0, 310)
MainFrame.Position = UDim2.new(0, 40, 0, 100)
MainFrame.BackgroundColor3 = Color3.fromRGB(45, 20, 90)
MainFrame.BorderSizePixel = 0
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 12)
UICorner.Parent = MainFrame

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 40)
Title.BackgroundTransparency = 1
Title.Text = "⚡ Lực Hub Pro 120Hz ⚡"
Title.TextColor3 = Color3.fromRGB(255, 220, 0)
Title.TextSize = 16
Title.Font = Enum.Font.GothamBold
Title.Parent = MainFrame

-- Nút Tối Ưu Đồ Họa & Fix Lag Toàn Diện
local BtnFixLag = Instance.new("TextButton")
BtnFixLag.Size = UDim2.new(0, 220, 0, 38)
BtnFixLag.Position = UDim2.new(0, 10, 0, 50)
BtnFixLag.BackgroundColor3 = Color3.fromRGB(80, 40, 140)
BtnFixLag.Text = "🚀 TẮT HIỆU ỨNG / FIX LAG"
BtnFixLag.TextColor3 = Color3.fromRGB(255, 255, 255)
BtnFixLag.TextSize = 13
BtnFixLag.Font = Enum.Font.GothamBold
BtnFixLag.Parent = MainFrame
Instance.new("UICorner", BtnFixLag).CornerRadius = UDim.new(0, 8)

BtnFixLag.MouseButton1Click:Connect(function()
    pcall(function()
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Material = Enum.Material.SmoothPlastic
                v.Reflectance = 0
            end
        end
    end)
    BtnFixLag.Text = "✅ ĐÃ TỐI ƯU ĐỒ HỌA"
end)

-- Nút Fast Attack (Tự động đánh nhanh không lỗi)
local BtnFast = Instance.new("TextButton")
BtnFast.Size = UDim2.new(0, 220, 0, 38)
BtnFast.Position = UDim2.new(0, 10, 0, 95)
BtnFast.BackgroundColor3 = Color3.fromRGB(80, 40, 140)
BtnFast.Text = "⚔️ BẬT FAST ATTACK"
BtnFast.TextColor3 = Color3.fromRGB(255, 255, 255)
BtnFast.TextSize = 14
BtnFast.Font = Enum.Font.GothamBold
BtnFast.Parent = MainFrame
Instance.new("UICorner", BtnFast).CornerRadius = UDim.new(0, 8)

local fastAttackEnabled = false
BtnFast.MouseButton1Click:Connect(function()
    fastAttackEnabled = not fastAttackEnabled
    if fastAttackEnabled then
        BtnFast.Text = "✅ ĐANG BẬT FAST ATTACK"
        task.spawn(function()
            while fastAttackEnabled do
                pcall(function()
                    local vim = game:GetService("VirtualInputManager")
                    vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                end)
                task.wait(0.05)
            end
        end)
    else
        BtnFast.Text = "⚔️ BẬT FAST ATTACK"
    end
end)

-- Nút ESP Player & Trái Ác Quỷ (Đã fix chuẩn khoảng cách mét)
local BtnEsp = Instance.new("TextButton")
BtnEsp.Size = UDim2.new(0, 220, 0, 38)
BtnEsp.Position = UDim2.new(0, 10, 0, 140)
BtnEsp.BackgroundColor3 = Color3.fromRGB(80, 40, 140)
BtnEsp.Text = "👁️ BẬT ESP (PLAYER + TRÁI)"
BtnEsp.TextColor3 = Color3.fromRGB(255, 255, 255)
BtnEsp.TextSize = 13
BtnEsp.Font = Enum.Font.GothamBold
BtnEsp.Parent = MainFrame
Instance.new("UICorner", BtnEsp).CornerRadius = UDim.new(0, 8)

local espEnabled = false
BtnEsp.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    if espEnabled then
        BtnEsp.Text = "✅ ĐANG BẬT ESP"
        task.spawn(function()
            while espEnabled do
                pcall(function()
                    -- ESP Người chơi
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                            if not p.Character.Head:FindFirstChild("LuchubESP") then
                                local bg = Instance.new("BillboardGui", p.Character.Head)
                                bg.Name = "LuchubESP"
                                bg.Size = UDim2.new(0, 100, 0, 40)
                                bg.AlwaysOnTop = true
                                local txt = Instance.new("TextLabel", bg)
                                txt.Size = UDim2.new(1, 0, 1, 0)
                                txt.BackgroundTransparency = 1
                                txt.TextColor3 = Color3.fromRGB(0, 255, 255)
                                txt.TextSize = 12
                                txt.Font = Enum.Font.GothamBold
                                txt.Text = p.Name
                            end
                        end
                    end
                    -- ESP Trái ác quỷ rơi tự nhiên kèm đo khoảng cách mét
                    for _, obj in pairs(Workspace:GetChildren()) do
                        if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
                            if not obj.Handle:FindFirstChild("FruitESP") then
                                local bg = Instance.new("BillboardGui", obj.Handle)
                                bg.Name = "FruitESP"
                                bg.Size = UDim2.new(0, 140, 0, 50)
                                bg.AlwaysOnTop = true
                                bg.StudsOffset = Vector3.new(0, 2, 0)
                                
                                local txt = Instance.new("TextLabel", bg)
                                txt.Size = UDim2.new(1, 0, 1, 0)
                                txt.BackgroundTransparency = 1
                                txt.TextColor3 = Color3.fromRGB(255, 50, 50)
                                txt.TextSize = 13
                                txt.Font = Enum.Font.GothamBold
                                txt.Parent = bg
                            end
                            
                            local espGui = obj.Handle:FindFirstChild("FruitESP")
                            if espGui and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                local hrp = LocalPlayer.Character.HumanoidRootPart
                                local distance = math.floor((hrp.Position - obj.Handle.Position).Magnitude)
                                local txtLabel = espGui:FindFirstChildOfClass("TextLabel")
                                if txtLabel then
                                    txtLabel.Text = "🍎 " .. obj.Name .. "\n[" .. distance .. "m]"
                                end
                            end
                        end
                    end
                end)
                task.wait(2)
            end
        end)
    else
        BtnEsp.Text = "👁️ BẬT ESP (PLAYER + TRÁI)"
        pcall(function()
            for _, p in pairs(Players:GetPlayers()) do
                if p.Character and p.Character:FindFirstChild("Head") then
                    local esp = p.Character.Head:FindFirstChild("LuchubESP")
                    if esp then esp:Destroy() end
                end
            end
        end)
    end
end)
